# Configurações do Banco de Dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/origin"

# Segurança
JWT_SECRET="sua-chave-secreta-muito-segura-aqui"

# Provisionamento inicial de producao (obrigatorio antes de liberar acesso)
# Use senhas fortes e remova/rotacione estes valores apos executar npm run db:harden.
AURA_MASTER_PASSWORD=""
AURA_ADMIN_PASSWORD=""

# Pool de conexoes. Em Vercel o padrao do app e 1 conexao por instancia.
DB_POOL_MAX=""

# Recuperacao emergencial do Master (temporario)
# Defina no Render apenas durante um deploy de recuperacao e remova logo depois.
AURA_MASTER_RESET_PASSWORD=""

# Ambiente
PORT=3000
NODE_ENV="development"

# Gemini (Opcional - para OCR futuro)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL
APP_URL="MY_APP_URL"

# Auditoria de performance (opcional)
# PERF_LOG_ENABLED=false desliga os logs de performance.
# PERF_LOG_ALL=false registra apenas rotas lentas.
# PERF_SLOW_MS=800 define a partir de quantos ms uma rota é considerada lenta.
# PERMISSION_CACHE_TTL_MS=120000 controla o cache de permissões por função/rota.
PERF_LOG_ENABLED=true
PERF_LOG_ALL=true
PERF_SLOW_MS=800
PERMISSION_CACHE_TTL_MS=120000

# Dropbox Backup (opcional)
DROPBOX_ACCESS_TOKEN=""
DROPBOX_BACKUP_FOLDER="/Backups Aura Sistemas"
